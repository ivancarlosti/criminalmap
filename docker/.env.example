# Crime Board / Investigation Network Graph — environment template.
# Copy this file to "docker/.env" and adjust the values for your environment:
#   cp docker/.env.example docker/.env

# Web Server & Reverse Proxy

# Port exposed to the Docker host machine. The app itself always listens on
# 8080 INSIDE the container (the image health check follows the container's
# PORT), so only this host-side number has to change — for example PORT=7899
# serves the app at http://localhost:7899. When running the app directly with
# `node server.js`, PORT is the port the API listens on.
PORT=8080

# Directory of the generated OpenGraph images INSIDE the container. It is mapped
# to ./webimages on the host by docker-compose, so it only needs a value when you
# run the app without Compose and want the cards somewhere else.
# WEBIMAGES_DIR=/app/webimages

# If you are using a reverse proxy (like Nginx), you can define the domain name here.
DOMAIN=criminalmap.example.com

# Database (MariaDB) — host.docker.internal reaches a database running on the Docker host.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=criminalmap

# Admin panel authentication (account mode)
#
# ADMIN_LOGIN and ADMIN_PASSWORD are comma separated, index aligned lists, so
# several administrators can be defined:
#   ADMIN_LOGIN=admin@example.com,editor@example.com
#   ADMIN_PASSWORD=a-strong-password,'scrypt$<saltHex>$<hashHex>'
# Generate a hashed password with: npm run hash-password -- "your password"
AUTH_METHOD=account
ADMIN_LOGIN=admin@example.com
ADMIN_PASSWORD=change_me

# Session signing secret. Use a long random value, e.g.:
#   openssl rand -hex 32
SESSION_SECRET=change_me_too

# Session lifetime in minutes (default: 720 = 12 hours).
SESSION_LIFETIME=720
