# Crime Board / Investigation Network Graph — environment template.
# Copy this file to "docker/.env" and adjust the values for your environment:
#   cp docker/.env.example docker/.env

# Web Server & Reverse Proxy

# Port exposed to the Docker host machine.
PORT=8080

# If you are using a reverse proxy (like Nginx), you can define the domain name here.
DOMAIN=criminalmap.example.com

# Database (MariaDB) — host.docker.internal reaches a database running on the Docker host.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=criminalmap
